{
  "description": "slimctx for Codex: condense Bash output, session rules",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node -e \"import(require('url').pathToFileURL(require('path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'bin','slimctx.mjs')).href).then(m=>m.main(['hook','session','--host','codex']))\"", "statusMessage": "slimctx", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node -e \"import(require('url').pathToFileURL(require('path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'bin','slimctx.mjs')).href).then(m=>m.main(['hook','codex-post']))\"", "statusMessage": "slimctx: condensing output", "timeout": 15 }]
      }
    ]
  }
}
